{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "别坐了",
  "mainBinaryName": "breakly",
  "version": "1.0.0",
  "identifier": "com.neopen.breakly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "别坐了 · Breakly",
        "width": 760,
        "height": 900,
        "minWidth": 640,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' http://localhost:1420; script-src 'self' 'unsafe-inline' http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; img-src 'self' data: http://localhost:1420; media-src 'self' http://localhost:1420; font-src 'self' http://localhost:1420; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "neopen",
    "homepage": "https://breakly.helpoke.com",
    "copyright": "Copyright © 2026 neopen",
    "shortDescription": "健康提醒与强制活动桌面应用",
    "longDescription": "定时提醒久坐用户起身活动，支持全屏提醒遮罩、全局键盘拦截、系统通知与自动更新。",
    "category": "HealthcareFitness",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNDZEQjQ5NkY3RENDRUMKUldUc3pIMXZTZHRHenhSeXBNeng1dVBxdUoydFFiRThJVUd6NDF3alpUWWhUZ2VSUEI0WlVub3AK",
      "endpoints": ["https://github.com/neopen/break-reminder/releases/latest/download/latest.json"]
    }
  }
}
