{
  "name": "breakly",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "Breakly - 健康提醒桌面应用（Tauri 2 + Vue 3 + TypeScript）",
  "license": "MIT",
  "author": {
    "name": "neopen",
    "email": "helpenx+clock@gmail.com",
    "url": "https://github.com/neopen"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neopen/break-reminder.git"
  },
  "homepage": "https://breakly.helpoke.com",
  "keywords": [
    "health",
    "reminder",
    "stand-up",
    "break-reminder",
    "sedentary",
    "desktop-app",
    "tauri"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "audio:generate": "node scripts/generate-audio.mjs",
    "postversion": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.6.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
