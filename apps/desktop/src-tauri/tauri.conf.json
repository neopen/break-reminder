{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HealthClock",
  "version": "0.7.0",
  "identifier": "com.neopen.healthclock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "别坐了 · HealthClock",
        "width": 720,
        "height": 820,
        "minWidth": 560,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNDZEQjQ5NkY3RENDRUMKUldUc3pIMXZTZHRHenhSeXBNeng1dVBxdUoydFFiRThJVUd6NDF3alpUWWhUZ2VSUEI0WlVub3AK",
      "endpoints": [
        "https://github.com/neopen/break-reminder/releases/latest/download/latest.json"
      ]
    }
  }
}
